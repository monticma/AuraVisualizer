{
  "name": "aura-visualizer",
  "displayName": "Aura Visualizer",
  "description": "Visualize your codebase in 3D directly in VSCode — interactive dependency graph with force-directed layout",
  "version": "0.1.0",
  "publisher": "aura",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization"],
  "keywords": ["3d", "visualization", "code-analysis", "dependency-graph", "codebase"],
  "activationEvents": [
    "onWebviewPanel:auraVisualizer.graphView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auraVisualizer.open",
        "title": "Aura: Visualize Codebase",
        "icon": "$(eye)"
      },
      {
        "command": "auraVisualizer.refresh",
        "title": "Aura: Refresh Visualization",
        "icon": "$(refresh)"
      },
      {
        "command": "auraVisualizer.focusFile",
        "title": "Aura: Focus Current File in Graph"
      },
      {
        "command": "auraVisualizer.openFileFromTree",
        "title": "Open File"
      },
      {
        "command": "auraVisualizer.exportGraph",
        "title": "Aura: Export Graph for AI",
        "icon": "$(export)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aura-explorer",
          "title": "Aura",
          "icon": "resources/aura-icon.svg"
        }
      ]
    },
    "views": {
      "aura-explorer": [
        {
          "id": "auraVisualizer.statsView",
          "name": "Codebase Overview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "auraVisualizer.refresh",
          "when": "view == auraVisualizer.statsView",
          "group": "navigation"
        },
        {
          "command": "auraVisualizer.open",
          "when": "view == auraVisualizer.statsView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "auraVisualizer.open",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "Aura Visualizer",
      "properties": {
        "auraVisualizer.excludePaths": {
          "type": "array",
          "default": ["node_modules", ".git", "dist", "build", "out", "__pycache__"],
          "description": "Directories to exclude from analysis"
        },
        "auraVisualizer.maxFiles": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of files to analyze"
        },
        "auraVisualizer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh visualization when files are saved"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "3d-force-graph": "^1.77.7",
    "three": "^0.170.0"
  }
}
